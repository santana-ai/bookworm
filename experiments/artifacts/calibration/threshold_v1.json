  "primary_rule": "masked_top1_youden",
  "primary_rule_declaration": "Declared on 2026-09-22, before any calibration result on real embeddings was computed. The threshold decides whether the top-1 sentence the encoder picks among the speaker's sentences becomes semantic_match_high, so the primary rule calibrates that decision directly: on train opinions whose quoted spans were removed (masked_quotes benchmark), top-1 is correct when it agrees with the quote target, and the threshold maximizes Youden's J of 'score >= t predicts a correct top-1'. The three pair rules are reported for comparison with the historical 0.47 and are not used to choose the threshold. Writing the chosen value into [evidence].embedding_threshold is a separate, recorded step.",
  "primary_threshold": 0.3928,
  "primary_threshold_rounded": 0.39,
  "configured_embedding_threshold": 0.47,
  "configured_embedding_threshold_modified": false,
  "label_semantics": {
    "target": "silver label: the sentence of the speaker's own turn that encloses the matched quote prefix of 6+ words (udv_pipeline.find_opinion_turn_quote_match), found by string matching and not validated by a human",
    "positive_score": "highest cosine between the query and the candidate sentences that agree with the target (sentences_agree); a target spanning two candidate sentences has two",
    "masked_queries": "masked opinions stand in for opinions without a quote, the ones the threshold is applied to; their wording may differ from paraphrases written without any quote",
    "in_sample": "every number here is measured on the calibration splits only; precision and coverage at a threshold chosen on the same queries are optimistic, and an unbiased estimate needs held-out queries"
  },
