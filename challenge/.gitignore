# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments and local secrets
.venv
.env

# Notebook checkpoints
.ipynb_checkpoints/

# Raw/downloaded data (never versioned)
dataset/

# Derived caches (embeddings, translations, model answers), regenerated by the utils commands
artifacts/cache/

# Heavy per-item experiment outputs, regenerated by the commands listed in
# artifacts/MANIFEST_heavy.tsv; the per-run and per-scorer *_report.json files stay versioned
artifacts/experiments/**/scores/*.jsonl
artifacts/experiments/**/queries/**/*.jsonl
artifacts/experiments/**/features/**/*.jsonl
artifacts/experiments/**/predictions/**/*.jsonl
artifacts/experiments/**/nli/pairs/**/*.jsonl
artifacts/experiments/**/nli/pairs_input.jsonl

# Blank review template written by utils.generate_udv_manual_review
udv_manual_review_template.json
